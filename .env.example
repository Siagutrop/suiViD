# =============================================================
# Suivi Raphael — Variables d'environnement
# Copier ce fichier en .env.development (dev local)
# ou configurer ces variables dans Docker / Portainer (prod).
# =============================================================

# ----- Mode de données -----
# mock   -> données locales fictives de démonstration (aucun accès Google)
# sheets -> Google Sheets réel (nécessite les identifiants ci-dessous)
# sqlite -> base SQLite locale (recommandé — voir DB_FILE + COACH_*)
DATA_MODE=sqlite

# ----- Authentification applicative (multi-utilisateur) -----
# Comptes email + mot de passe stockés dans USERS_FILE (JSON).
# Création de compte ouverte ; mettre "false" pour désactiver l'inscription.
ALLOW_SIGNUP=true
# Fichier des comptes utilisateurs (défaut : <repo>/data/users.json ;
# en Docker : /data/users.json via le volume).
# USERS_FILE=/data/users.json
# Mot de passe du compte démo (demo@suivid.app) créé quand la base
# est vide — à définir fort en production ou désactiver après usage.
# DEMO_PASSWORD=dev
# Secret de signature des jetons de session (chaîne aléatoire longue).
AUTH_SECRET=change-me-with-a-long-random-string
# Durée de validité d'une session, en secondes (défaut : 7 jours).
SESSION_TTL_SECONDS=604800

# ----- SQLite (DATA_MODE=sqlite) -----
# Fichier de base de données (défaut : <repo>/data/suivid.db ;
# en Docker : /data/suivid.db via le volume — déjà persisté).
# DB_FILE=/data/suivid.db
# Compte coach (interface d'administration) créé au démarrage si absent.
# Définir un mot de passe fort en production.
# COACH_EMAIL=coach@example.com
# COACH_PASSWORD=change-me

# ----- Google Sheets (obligatoire seulement si DATA_MODE=sheets) -----
# Identifiant du classeur (l'ID dans l'URL du Google Sheets).
# /!\\ Utiliser une COPIE de test pendant le développement.
GOOGLE_SPREADSHEET_ID=

# --- Option 1 : compte de service (recommandé pour Docker/prod) ---
# Chemin vers le fichier JSON de clé du compte de service.
GOOGLE_SERVICE_ACCOUNT_FILE=
# OU contenu JSON complet (une seule ligne) — pratique en variable d'env :
GOOGLE_SERVICE_ACCOUNT_JSON=
# OU clé privée + email séparés :
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# --- Option 2 : OAuth 2.0 utilisateur (dev personnel) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# ----- Serveur API -----
PORT=3001
HOST=0.0.0.0
# Origine autorisée pour CORS (dev : http://localhost:5173).
CORS_ORIGIN=http://localhost:5173
# Niveau de log : debug | info | warn | error
LOG_LEVEL=info

# ----- Frontend (uniquement pour la build Vite) -----
# URL de l'API vue par le navigateur. Laisser vide pour utiliser
# le chemin relatif /api (proxy dev Vite ou reverse proxy prod).
VITE_API_URL=
COACH_EMAIL=coach@example.com
COACH_PASSWORD=RemplaceParUnMotDePasseLongEtUnique
