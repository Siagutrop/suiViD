{
  "name": "@suivi/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/index.js --external:googleapis --external:jose --external:zod --external:fastify --external:@fastify/cors --external:@fastify/static --external:pino --external:pino-pretty --external:better-sqlite3",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "setup-sheets": "tsx src/scripts/setup-sheets.ts",
    "migrate": "tsx src/migrate-from-sheets.ts",
    "import-off": "tsx src/offSync.cli.ts"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/static": "^7.0.4",
    "@suivi/shared": "*",
    "better-sqlite3": "^12.11.1",
    "fastify": "^4.28.1",
    "googleapis": "^144.0.0",
    "jose": "^5.9.6",
    "pino-pretty": "^11.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.9.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.2",
    "typescript": "~5.6.3",
    "vitest": "^2.1.4"
  }
}
